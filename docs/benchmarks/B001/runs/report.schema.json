{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "B001 Benchmark Report",
    "type": "object",
    "required": [
        "benchmark_id",
        "run_id",
        "verdict",
        "baseline_variant",
        "candidate_variant",
        "pass_rate_delta",
        "quality_delta",
        "compliance_violation_delta",
        "cost_per_pass_delta",
        "p50_latency_delta",
        "p90_latency_delta",
        "regressions_by_family"
    ],
    "properties": {
        "benchmark_id": {
            "type": "string"
        },
        "run_id": {
            "type": "string"
        },
        "verdict": {
            "type": "string",
            "enum": [
                "PASS",
                "FAIL",
                "REVIEW_REQUIRED"
            ]
        },
        "baseline_variant": {
            "type": "string"
        },
        "candidate_variant": {
            "type": "string"
        },
        "pass_rate_delta": {
            "type": "number"
        },
        "quality_delta": {
            "type": "number"
        },
        "compliance_violation_delta": {
            "type": "number"
        },
        "cost_per_pass_delta": {
            "type": "number"
        },
        "p50_latency_delta": {
            "type": "number"
        },
        "p90_latency_delta": {
            "type": "number"
        },
        "regressions_by_family": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "family",
                    "pass_rate_delta",
                    "quality_delta"
                ],
                "properties": {
                    "family": {
                        "type": "string"
                    },
                    "pass_rate_delta": {
                        "type": "number"
                    },
                    "quality_delta": {
                        "type": "number"
                    }
                }
            }
        }
    }
}