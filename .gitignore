.DS_Store
.venv/
.coverage
.generated-global-hooks/
dev/*
# PR Review: track the pinned base/head fixture, ignore run output. The report
# root is `dev/pr-review/<base-sha-short>-<UTC-timestamp>/`, which stays ignored
# by `dev/pr-review/*` -- only `fixtures/` is un-ignored back in.
!dev/pr-review/
dev/pr-review/*
!dev/pr-review/fixtures/
!dev/pr-review/fixtures/**
__pycache__/
*.pyc

# Local benchmark runtime artifacts (reports/traces) to prevent branch checkout clashes
docs/benchmarks/B001/runs/local/
# Added by code-review-graph
.code-review-graph/

.vscode
eval/runs/
file-access-guard.ndjson
.deploy-config.json
dev/*

.github