{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "code-review-graph update --skip-flows",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "",
        "$source": "audit-log",
        "hooks": [
          {
            "type": "command",
            "command": "bash .github/hooks/scripts/audit-log.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "code-review-graph status",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "$source": "done-notify",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Codex is done\" with title \"Codex\"'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "$source": "file-access-guard",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .github/hooks/scripts/file-access-guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
