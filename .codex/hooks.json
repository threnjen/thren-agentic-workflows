{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "code-review-graph update --skip-flows",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "",
        "$source": "audit-log",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.github/hooks/scripts/audit-log.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read|Bash|Grep|WebFetch|WebSearch|Task|apply_patch|mcp__.*",
        "$source": "injection-scanner",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.github/hooks/scripts/injection-scanner.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "code-review-graph status",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "$source": "done-notify",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e display notification \"Codex is done\" with title \"Codex\""
          }
        ]
      }
    ]
  }
}
