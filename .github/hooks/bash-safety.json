{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "type": "command",
        "command": "bash .github/hooks/scripts/bash-safety.sh",
        "timeout": 10
      }
    ]
  },
  "$meta": {
    "description": "Gate destructive bash commands behind user confirmation. Based on the Anthropic Claude hooks article example.",
    "PreToolUse": {
      "claude": ["PreToolUse"],
      "codex": ["PreToolUse"],
      "opencode": ["pre_tool_call"]
    },
    "blocked_patterns": [
      "rm -rf",
      "git push --force",
      "git reset --hard",
      "git clean -f",
      "chmod -R 777",
      "dd if=",
      "mkfs",
      "> /dev/",
      "truncate",
      "shred"
    ]
  }
}
