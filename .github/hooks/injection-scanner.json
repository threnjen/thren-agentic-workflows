{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Read|Bash|Grep|WebFetch|WebSearch|Task|apply_patch|mcp__.*",
        "type": "command",
        "command": "python3 .github/hooks/scripts/injection-scanner.py",
        "timeout": 10
      }
    ]
  },
  "$meta": {
    "description": "PostToolUse indirect-injection scanning for successful tool output."
  }
}
