{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Bash",
        "type": "command",
        "command": "python3 .github/hooks/scripts/file-access-guard.py",
        "timeout": 10
      }
    ]
  },
  "$meta": {
    "description": "Data-driven file-access protection shared by Phase 01 security analyzers."
  }
}
