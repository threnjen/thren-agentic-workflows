{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "code-review-graph update --skip-flows",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "",
        "$source": "audit-log",
        "hooks": [
          {
            "type": "command",
            "command": "bash .github/hooks/scripts/audit-log.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "code-review-graph status",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "$source": "bash-safety",
        "hooks": [
          {
            "type": "command",
            "command": "bash .github/hooks/scripts/bash-safety.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "$source": "protect-files",
        "hooks": [
          {
            "type": "command",
            "command": "bash .github/hooks/scripts/protect-files.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "$source": "done-notify",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Claude is done\" with title \"Claude Code\"'"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "$source": "done-notify",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Claude is done\" with title \"Claude Code\"'"
          }
        ]
      }
    ]
  }
}
